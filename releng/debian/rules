#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	# ocicl and dependencies are expected to be pre-installed
	make ag-protoc
	make src/grpc-proto.lisp
	make cloodoo

override_dh_auto_install:
	mkdir -p debian/cloodoo/usr/bin
	install -m 755 cloodoo debian/cloodoo/usr/bin/cloodoo
	# Systemd user units for due/overdue notifications (cloodoo-6he)
	mkdir -p debian/cloodoo/usr/lib/systemd/user
	install -m 644 releng/systemd/cloodoo-notify.service debian/cloodoo/usr/lib/systemd/user/
	install -m 644 releng/systemd/cloodoo-notify.timer debian/cloodoo/usr/lib/systemd/user/
